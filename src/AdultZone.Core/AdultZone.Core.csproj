<Project Sdk="Microsoft.NET.Sdk">

  <!-- The library itself: database, scanning, artwork and metadata. No NuGet
       packages — SQLite is reached directly (see Data/Sqlite.cs). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AdultZone.Core</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

</Project>
